{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.fedos.desktop.beta",
  "productName": "FedOS Desktop Beta",
  "directories": {
    "output": "dist-package-beta"
  },
  "files": [
    "dist/fedos_electron_beta_main.cjs",
    "dist/fedos_electron_beta_preload.cjs",
    "dist/fedos_electron_beta_renderer.js",
    "dist/fedos_electron_beta_page.html",
    "package.json",
    "node_modules/**/*",
    "!**/*.map",
    "!src/**/*",
    "!test/**/*"
  ],
  "extraMetadata": {
    "main": "dist/fedos_electron_beta_main.cjs",
    "scripts": {}
  },
  "extraFiles": [
    { "from": "../../dist", "to": "dist" },
    { "from": "../../LICENSE", "to": "LICENSE.txt" },
    { "from": "../../THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md" }
  ],
  "extraResources": [
    { "from": "../fedos-core-rust/pkg", "to": "fedos-core-rust/pkg" }
  ],
  "asar": true,
  "win": {
    "target": ["nsis", "zip"]
  },
  "linux": {
    "target": ["dir"]
  },
  "mac": {
    "target": ["dir"]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "runAfterFinish": false,
    "deleteAppDataOnUninstall": false,
    "artifactName": "FedOS-Desktop-Beta-Setup-${version}.${ext}"
  },
  "npmRebuild": false,
  "compression": "store"
}
