{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/fedos_electron_spike_renderer.ts", "src/fedos_electron_host_adapter_selftest.ts", "src/fedos_electron_spike_window.d.ts", "src/fedos_electron_host_adapter_window.d.ts"]
}
