{
  "name": "nostr-window",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Reddit-style window into Nostr — MVP prototype (Stage 1: read-only event ingest).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:wasm": "cargo build --manifest-path packages/fedos-core-rust/Cargo.toml --target wasm32-unknown-unknown --release && wasm-bindgen --target web --out-dir packages/fedos-core-rust/pkg packages/fedos-core-rust/target/wasm32-unknown-unknown/release/fedos_core_rust.wasm",
    "build:runtime": "tsc -p tsconfig.runtime.json",
    "start:runtime": "npm run build:runtime && node dist/desktop/runtime/run_fedos_desktop_runtime.js",
    "build:electron-spike": "tsc -p tsconfig.electron-spike.json && node src/desktop/electron_spike/copy_electron_spike_static_assets.mjs",
    "start:electron-spike": "npm run build:electron-spike && electron dist-electron-spike/fedos_electron_spike_main.cjs",
    "package:electron-spike": "npm run build:electron-spike && node src/desktop/electron_spike/run_electron_builder_spike_package.mjs",
    "test:electron-spike": "vitest run test/secure_runtime_alpha_3881_3940_electron_build_spike.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0"
  }
}
