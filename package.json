{
  "name": "nostr-window",
  "version": "0.0.1",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "description": "FedOS Desktop — a focused, end-to-end encrypted Direct-message secure messenger (Closed Beta), built on Nostr (NIP-17) with a Double Ratchet session per conversation. Originally began as \"nostr-window,\" a broader Reddit-style window into Nostr (MVP prototype, Stage 1: read-only event ingest); see README.md for the full history.",
  "scripts": {
    "typecheck:core": "tsc --noEmit",
    "typecheck:electron": "npm run typecheck --prefix packages/fedos-desktop-electron-spike",
    "typecheck": "npm run typecheck:core && npm run typecheck:electron",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:wasm": "cargo build --manifest-path packages/fedos-core-rust/Cargo.toml --target wasm32-unknown-unknown --release && wasm-bindgen --target web --out-dir packages/fedos-core-rust/pkg packages/fedos-core-rust/target/wasm32-unknown-unknown/release/fedos_core_rust.wasm",
    "build:wasm:manifest": "node scripts/generate_wasm_artifact_manifest.mjs",
    "build:production-wasm": "node scripts/build_production_wasm_artifact.mjs",
    "build:runtime": "tsc -p tsconfig.runtime.json",
    "build:unlock-runtime": "tsc -p tsconfig.unlock-runtime.json",
    "start:runtime": "npm run build:runtime && node dist/os/messenger/desktop/runtime/run_fedos_desktop_runtime.js",
    "build:host-bridge": "tsc -p tsconfig.host-bridge.json",
    "build:settings-host-bridge": "tsc -p tsconfig.settings-host-bridge.json",
    "build:beta-runtime": "tsc -p tsconfig.beta-runtime.json",
    "build:electron-spike": "npm run build --prefix packages/fedos-desktop-electron-spike",
    "start:electron-spike": "npm run start --prefix packages/fedos-desktop-electron-spike",
    "package:electron-spike": "npm run package --prefix packages/fedos-desktop-electron-spike",
    "package:electron-beta": "npm run package:beta --prefix packages/fedos-desktop-electron-spike",
    "release:electron-beta": "npm run release:beta --prefix packages/fedos-desktop-electron-spike",
    "test:electron-spike": "vitest run --config vitest.electron-spike.config.ts",
    "start:electron-host-adapter": "npm run start:host-adapter --prefix packages/fedos-desktop-electron-spike",
    "start:electron-navigation": "npm run start:navigation --prefix packages/fedos-desktop-electron-spike",
    "start:electron-notifications-tray": "npm run start:notifications-tray --prefix packages/fedos-desktop-electron-spike",
    "start:electron-badge": "npm run start:badge --prefix packages/fedos-desktop-electron-spike",
    "start:electron-unlock": "npm run start:unlock --prefix packages/fedos-desktop-electron-spike",
    "start:electron-settings": "npm run start:settings --prefix packages/fedos-desktop-electron-spike",
    "start:electron-beta": "npm run start:beta --prefix packages/fedos-desktop-electron-spike",
    "trust:issuer": "tsc -p tsconfig.trust-issuer.json && node scripts/fedos_trust_issuer_cli.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "qrcode": "^1.5.4"
  }
}
